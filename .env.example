# Copie para .env e preencha. NUNCA envie o .env para o GitHub.

# Senha do banco (crie uma forte, só letras e números)
POSTGRES_PASSWORD=

# Endereço público do site, com https:// e sem barra no fim
APP_URL=https://observajuv.oriximina.pa.gov.br

# Só o domínio (sem https://). Usado pelo HTTPS automático (perfil "https")
SITE_DOMAIN=observajuv.oriximina.pa.gov.br

# Porta interna do site. Com o HTTPS automático, não precisa mexer.
WEB_PORT=8080
# 127.0.0.1 = só o próprio servidor acessa a porta acima (recomendado)
WEB_BIND=127.0.0.1
# Use false só para testar sem HTTPS (ex.: http://localhost:8080)
COOKIE_SECURE=true
# Proxies na frente da API (padrão 2). Ver docs/DEPLOY.md, passo 17.2
# TRUST_PROXY_HOPS=2

# E-mail (confirmação de cadastro e "esqueci a senha").
# Gmail/Google Workspace: smtp.gmail.com, porta 465, SMTP_SECURE=true,
# SMTP_PASS = senha de app de 16 letras (sem espaços).
# SMTP_FROM deve usar o mesmo endereço de SMTP_USER.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Observatório da Juventude <MESMO_ENDERECO_DO_SMTP_USER>

# Login com Google (Google Cloud Console > Credenciais > ID do cliente OAuth)
# URI de redirecionamento autorizado: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
