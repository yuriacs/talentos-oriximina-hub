# Copie para .env e preencha. NUNCA envie o .env para o GitHub.

# Senha do banco (crie uma forte, só letras e números)
POSTGRES_PASSWORD=

# Endereço público do site, sem barra no fim
APP_URL=https://observajuv.oriximina.pa.gov.br

# Porta onde o site fica disponível no servidor (o HTTPS fica no proxy da Prefeitura)
WEB_PORT=8080
# Use false só para testar sem HTTPS (ex.: http://localhost:8080)
COOKIE_SECURE=true

# E-mail institucional (confirmação de cadastro e "esqueci a senha")
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Observatório da Juventude <semju@oriximina.pa.gov.br>

# Login com Google (Google Cloud Console > Credenciais > ID do cliente OAuth)
# URI de redirecionamento autorizado: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
